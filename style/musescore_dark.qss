
/* =====================================================
   MuseScore 4 Inspired Theme
   Qt Widgets / PySide6 / PyQt6
   ===================================================== */

/* Global */
QWidget {
    background-color: #242629;
    color: #e2e2e2;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 10pt;
    selection-background-color: #3975a8;
    selection-color: #ffffff;
}

QMainWindow {
    background-color: #242629;
}

/* Central area */
QWidget#centralwidget {
    background-color: #242629;
}

/* Labels */
QLabel {
    color: #d5d5d5;
    background: transparent;
    padding: 2px;
}

/* Group boxes */
QGroupBox {
    background-color: #2b2e32;
    border: 1px solid #414449;
    border-radius: 6px;
    margin-top: 13px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #dedede;
}

QFrame {
    background-color: #2b2e32;
    border-radius: 6px
}

/* Text inputs */
QLineEdit {
    background-color: #1d1f22;
    border: 1px solid #44484e;
    border-radius: 4px;
    padding: 7px 9px;
    color: #eeeeee;
    selection-background-color: #3975a8;
}

QLineEdit:hover {
    border-color: #626970;
}

QLineEdit:focus {
    border: 1px solid #4b91c7;
}

/* File list */
QListWidget {
    background-color: #1d1f22;
    border: 1px solid #414449;
    border-radius: 5px;
    padding: 5px;
    outline: none;
}

QListWidget::item {
    background-color: transparent;
    border-radius: 3px;
    padding: 8px;
    margin: 2px;
}

QListWidget::item:hover {
    background-color: #34383d;
}

QListWidget::item:selected {
    background-color: #365f82;
    color: #ffffff;
}

/* Buttons */
QPushButton {
    background-color: #383c41;
    border: 1px solid #4a4f55;
    border-radius: 4px;
    color: #eeeeee;
    padding: 7px 14px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #464c53;
    border-color: #626970;
}

QPushButton:pressed {
    background-color: #292c30;
}

QPushButton:disabled {
    background-color: #2c2f32;
    color: #777777;
    border-color: #383b3f;
}

/* Main action button */
QPushButton#btnMerge {
    background-color: #397caf;
    border: 1px solid #438dc3;
    border-radius: 4px;
    color: white;
    font-weight: 600;
    min-height: 28px;
}

QPushButton#btnMerge:hover {
    background-color: #478fc5;
}

QPushButton#btnMerge:pressed {
    background-color: #2d6590;
}

/* Add files button */
QPushButton#btnAddFiles {
    background-color: #365f82;
    border-color: #477da7;
}

QPushButton#btnAddFiles:hover {
    background-color: #42749d;
}

/* Checkboxes */
QCheckBox {
    spacing: 8px;
    color: #d8d8d8;
    background: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #666c73;
    border-radius: 3px;
    background-color: #1d1f22;
}

QCheckBox::indicator:hover {
    border-color: #5598c8;
}

QCheckBox::indicator:checked {
    background-color: #397caf;
    border: 1px solid #4b91c7;
    image: url(:/assets/check.svg);
}

/* Log output */
QPlainTextEdit {
    background-color: #191b1e;
    color: #c4c9ce;
    border: 1px solid #414449;
    border-radius: 5px;
    padding: 8px;
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 9pt;
}

/* Toolbar */
QToolBar {
    background-color: #2b2e32;
    border: none;
    border-bottom: 1px solid #414449;
    spacing: 6px;
    padding: 5px;
}

QToolBar::separator {
    background-color: #484c51;
    width: 1px;
    margin: 4px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #242629;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #50555c;
    border-radius: 5px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6a7179;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #242629;
    height: 12px;
}

QScrollBar::handle:horizontal {
    background-color: #50555c;
    border-radius: 5px;
    min-width: 25px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Tooltips */
QToolTip {
    background-color: #34383d;
    color: #eeeeee;
    border: 1px solid #555b62;
    padding: 5px;
    border-radius: 3px;
}

/* Menus */
QMenu {
    background-color: #2b2e32;
    color: #eeeeee;
    border: 1px solid #454a50;
    padding: 4px;
}

QMenu::item {
    padding: 7px 25px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #365f82;
}

QMenu::separator {
    height: 1px;
    background-color: #454a50;
    margin: 4px 8px;
}

/* Status bar */
QStatusBar {
    background-color: #2b2e32;
    color: #bfc3c7;
    border-top: 1px solid #414449;
}
